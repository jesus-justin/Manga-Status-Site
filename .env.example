# Manga Status Site - Environment Configuration Template
# Copy this file to .env and update with your actual values

# Application Environment
APP_ENV=development
APP_DEBUG=true
APP_NAME=MangaLibrary
APP_VERSION=2.0.0

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=manga_library
DB_CHARSET=utf8mb4

# Application URL
APP_URL=http://localhost/Manga-Status-Site

# Security Settings
SESSION_TIMEOUT=3600
REMEMBER_ME_DURATION=2592000
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=900
PASSWORD_MIN_LENGTH=8

# Session Cookie Security
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# File Uploads
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=info
LOG_PATH=logs
LOG_MAX_SIZE=10485760

# API Configuration
API_RATE_LIMIT=100
API_RATE_WINDOW=3600
API_VERSION=v1

# Email Configuration (Optional)
MAIL_DRIVER=mail
MAIL_FROM=noreply@manga-library.local
MAIL_FROM_NAME=Manga Library

# Cache Configuration
CACHE_DRIVER=file
CACHE_TTL=3600

# Security Headers
ENABLE_HSTS=false
ENABLE_CSP=true

# Monitoring & Backup
ENABLE_BACKUP=true
BACKUP_PATH=backups
BACKUP_RETENTION_DAYS=30

# Rate Limiting
ENABLE_RATE_LIMITING=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_MINUTES=60

# Database Backup
DB_BACKUP_ENABLED=true
DB_BACKUP_SCHEDULE=daily
